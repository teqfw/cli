{
  "name": "@teqfw/cli",
  "version": "2.4.0",
  "description": "Standard Node.js process host and composition root for TeqFW applications.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Alex Gusev <alex@flancer64.com>",
  "homepage": "https://github.com/teqfw/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teqfw/cli.git"
  },
  "bugs": {
    "url": "https://github.com/teqfw/cli/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "teq": "bin/teq.mjs"
  },
  "types": "types.d.ts",
  "files": [
    "skills/",
    "src/",
    "bin/",
    "jsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "types.d.ts"
  ],
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "TeqFw_Cli_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      },
      "cli": {
        "commands": [
          {
            "id": "cfg:sort",
            "summary": "Order a valid dotenv configuration file.",
            "arguments": [
              {
                "name": "file",
                "kind": "string",
                "required": false,
                "description": "Dotenv file path, relative to the launch cwd."
              }
            ],
            "options": [
              {
                "name": "check",
                "kind": "boolean",
                "description": "Fail when the file requires ordering."
              },
              {
                "name": "dry-run",
                "kind": "boolean",
                "description": "Report a pending rewrite without changing the file."
              }
            ],
            "component": "TeqFw_Cli_Cli_Command_Cfg_Sort$"
          }
        ]
      }
    }
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:package && npm run test:integration && npm run test:acceptance",
    "test:unit": "find test/unit -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:package": "find test/package -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:integration": "find test/integration -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:acceptance": "find test/acceptance -name '*.test.mjs' -print0 | xargs -0 node --test",
    "validate:esm": "teqfw-esm-validator src --profile base",
    "validate:ctx": "node bin/teq.mjs --host @flancer32/skill-adsm-ctx adsm-ctx:validate .",
    "typecheck": "tsc -p jsconfig.json",
    "lint:md": "markdownlint-cli2 \"skills/**/*.md\" \"*.md\""
  },
  "dependencies": {
    "@teqfw/cfg": ">=2.0.0",
    "@teqfw/di": ">=2.11.0",
    "@teqfw/log": ">=2.0.0"
  },
  "devDependencies": {
    "@teqfw/di": "github:teqfw/di#main",
    "@types/node": "^26.1.2",
    "markdownlint-cli2": "^0.23.2",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0"
  },
  "overrides": {
    "smol-toml": "1.7.1"
  }
}
